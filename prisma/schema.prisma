generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String?
  baseCurrency   String   @default("AED")
  countryCode    String?
  billingEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  roles          Role[]
  categories     Category[]
  locations     Location[]
  suppliers     Supplier[]
  staff          Staff[]
  rawMaterials   RawMaterial[]
  products       Product[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  customers      Customer[]
  quotations     Quotation[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  staff          Staff?
  roles          UserRole[]

  @@unique([organizationId, email])
}

model Role {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?

  userRoles      UserRole[]

  @@unique([organizationId, name])
}

model UserRole {
  id             String @id @default(cuid())
  organizationId  String
  userId         String
  roleId         String

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, roleId])
}

model Staff {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  jobTitle       String?
  department     String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  quotations       Quotation[]
}

enum CategoryType {
  RAW_MATERIAL
  PRODUCT
  GENERAL
}

model Category {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           CategoryType
  parentId       String?
  parent         Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  createdAt      DateTime @default(now())

  rawMaterials   RawMaterial[]
  products       Product[]

  @@unique([organizationId, type, name])
}

model Location {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  locationType   String
  addressLine1   String?
  city           String?
  country        String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierName   String
  contactName    String?
  phone          String?
  email          String?
  taxId          String?
  paymentTerms   String?
  defaultCurrency String? @default("AED")
  createdAt      DateTime @default(now())

  @@unique([organizationId, supplierName])
}

model RawMaterial {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  sku            String
  itemName       String
  uom            String
  baseCost       Decimal @db.Decimal(18, 4)
  reorderPoint   Decimal @db.Decimal(18, 4)
  description    String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, sku])
}

model Product {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  sku            String
  itemName       String
  sellingPrice   Decimal @db.Decimal(18, 4)
  barcode        String?
  imageUrl      String?
  description    String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, sku])
}

model PurchaseRequest {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestNo      String
  requestedByStaffId String
  requestedBy    Staff @relation(fields: [requestedByStaffId], references: [id], onDelete: Restrict)
  status         String @default("DRAFT")
  requestDate    DateTime @default(now())
  notes          String?

  @@unique([organizationId, requestNo])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNo           String
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  issuedByStaffId String
  issuedBy       Staff @relation(fields: [issuedByStaffId], references: [id], onDelete: Restrict)
  orderDate      DateTime @default(now())
  status         String @default("DRAFT")
  subtotal       Decimal @db.Decimal(18, 4)
  taxAmount      Decimal @db.Decimal(18, 4)
  totalAmount    Decimal @db.Decimal(18, 4)

  @@unique([organizationId, poNo])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerName   String
  contactName    String?
  email          String?
  phone          String?
  taxId          String?
  creditLimit    Decimal? @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  @@unique([organizationId, customerName])
}

model Quotation {
  id             String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteNo        String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedByStaffId String
  issuedBy       Staff @relation(fields: [issuedByStaffId], references: [id], onDelete: Restrict)
  validUntil     DateTime?
  status         String @default("DRAFT")
  subtotal       Decimal @db.Decimal(18, 4)
  taxAmount      Decimal @db.Decimal(18, 4)
  totalAmount    Decimal @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  @@unique([organizationId, quoteNo])
}
